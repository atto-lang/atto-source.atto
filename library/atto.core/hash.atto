// Self-hosted Atto compiler independent noncryptographic byte fold.
// Checked i64, state [0,1000000007), octet 0..255, invalid=-1.
// Do not use this as a password hash or hostile-key map hash.
define module hash as
  pub fnc initial_state(): int { return 17; }
  pub fnc step_byte(int state, int octet): int {
    if state < 0 || state >= 1000000007; do return -1; fi
    if octet < 0 || octet > 255; do return -1; fi
    let int value = state * 31 + octet;
    // value < 32 * modulus; descending powers of two reduce in five
    // bounded steps without division, loops or overflowing signed i64.
    if value >= 16000000112; do value = value - 16000000112; fi
    if value >= 8000000056; do value = value - 8000000056; fi
    if value >= 4000000028; do value = value - 4000000028; fi
    if value >= 2000000014; do value = value - 2000000014; fi
    if value >= 1000000007; do value = value - 1000000007; fi
    return value;
  }
  pub fnc two_bytes(int a, int b): int {
    let int first = step_byte(initial_state(), a);
    if first < 0; do return -1; fi
    return step_byte(first, b);
  }
  pub fnc from_bool(bool value): int {
    if value; do return step_byte(initial_state(), 1); fi
    return step_byte(initial_state(), 0);
  }
end
