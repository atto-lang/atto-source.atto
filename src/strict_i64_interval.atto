// Stage-0 Atto-authored, nonallocating interval admission kernel.
// Returns 1 when the stated operation is proved safe, 0 if not, -1 for
// malformed ranges. Not a parser, compiler CLI or self-hosting claim.
pub fnc prove_i64_add(int alo, int ahi, int blo, int bhi): int {
    if alo > ahi then
        return -1;
    fi
    if blo > bhi then
        return -1;
    fi
    val max: int = 9223372036854775807;
    val min: int = -9223372036854775807 - 1;
    // Subtractions are safe because the corresponding sign is checked.
    if bhi > 0 then
        if ahi > max - bhi then
            return 0;
        fi
    fi
    if blo < 0 then
        if alo < min - blo then
            return 0;
        fi
    fi
    return 1;
}
pub fnc prove_i64_div(int alo, int ahi, int blo, int bhi): int {
    if alo > ahi then
        return -1;
    fi
    if blo > bhi then
        return -1;
    fi
    if blo <= 0 then
        if bhi >= 0 then
            return 0;
        fi
    fi
    val min: int = -9223372036854775807 - 1;
    if alo eq min then
        if blo <= -1 then
            if bhi >= -1 then
                return 0;
            fi
        fi
    fi
    return 1;
}
// Receiver length is a supplied proof fact, not a pointer or array identity.
pub fnc prove_fixed_index(int lo, int hi, int length): int {
    if lo > hi then
        return -1;
    fi
    if length < 1 then
        return -1;
    fi
    if length > 16 then
        return -1;
    fi
    if lo < 0 then
        return 0;
    fi
    if hi >= length then
        return 0;
    fi
    return 1;
}

// Signed subtraction: compare endpoints without negating INT64_MIN.
pub fnc prove_i64_sub(int alo, int ahi, int blo, int bhi): int {
    if alo > ahi then
        return -1;
    fi
    if blo > bhi then
        return -1;
    fi
    val max: int = 9223372036854775807;
    val min: int = -9223372036854775807 - 1;
    if blo < 0 then
        if ahi > max + blo then
            return 0;
        fi
    fi
    if bhi > 0 then
        if alo < min + bhi then
            return 0;
        fi
    fi
    return 1;
}
// Ordinary Atto int/int division is floating point. Use a bounded
// signed doubling proof instead, retaining negative accumulators so MIN is
// representable. Each arithmetic operation is guarded before evaluation.
pub fnc prove_i64_mul_pair(int a, int b): int {
    val min: int = -9223372036854775807 - 1;
    if a eq 0 then
        return 1;
    fi
    if b eq 0 then
        return 1;
    fi
    if a eq min then
        if b eq 1 then
            return 1;
        fi
        return 0;
    fi
    if b eq min then
        if a eq 1 then
            return 1;
        fi
        return 0;
    fi
    let int term = a;
    let int factor = b;
    let int limit = min;
    if a < 0 then
        if b < 0 then
            limit = -9223372036854775807;
        fi
    else
        term = 0 - a;
        if b > 0 then
            limit = -9223372036854775807;
        fi
    fi
    if b < 0 then
        factor = 0 - b;
    fi
    let int total = 0;
    while factor > 0 {
        val half: int = factor ashr 1;
        if factor - half * 2 eq 1 then
            if total < limit - term then
                return 0;
            fi
            total = total + term;
        fi
        factor = half;
        if factor > 0 then
            if term < limit - term then
                return 0;
            fi
            term = term + term;
        fi
    }
    return 1;
}
// A bilinear product over an integer rectangle attains its extrema at corners.
pub fnc prove_i64_mul(int alo, int ahi, int blo, int bhi): int {
    if alo > ahi then
        return -1;
    fi
    if blo > bhi then
        return -1;
    fi
    if prove_i64_mul_pair(alo, blo) eq 0 then
        return 0;
    fi
    if prove_i64_mul_pair(alo, bhi) eq 0 then
        return 0;
    fi
    if prove_i64_mul_pair(ahi, blo) eq 0 then
        return 0;
    fi
    if prove_i64_mul_pair(ahi, bhi) eq 0 then
        return 0;
    fi
    return 1;
}
