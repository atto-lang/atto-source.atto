        if total < limit - term then
            return 0;
        fi
        total = total + term;
    fi
    factor = half55;
    if factor > 0 then
        if term < limit - term then
            return 0;
        fi
        term = term + term;
    fi
    if factor eq 0 then
        return 1;
    fi
    val half56: int = factor ashr 1;
    if factor - half56 * 2 eq 1 then
        if total < limit - term then
            return 0;
        fi
        total = total + term;
    fi
    factor = half56;
    if factor > 0 then
