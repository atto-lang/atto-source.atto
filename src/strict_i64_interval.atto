fnc mul_proof_nonmin(int a, int b): int {
    val min: int = -9223372036854775807 - 1;
    if a < 0 then
        if b < 0 then
            return mul_proof_stage0(a, 0-b, 0, -9223372036854775807);
        fi
        return mul_proof_stage0(a, b, 0, min);
    fi
    if b < 0 then
        return mul_proof_stage0(0-a, 0-b, 0, min);
    fi
    return mul_proof_stage0(0-a, b, 0, -9223372036854775807);
}
pub fnc prove_i64_mul_pair(int a, int b): int {
    val min: int = -9223372036854775807 - 1;
    if a eq 0 then
        return 1;
    fi
    if b eq 0 then
        return 1;
    fi
    if a eq min then
        if b eq 1 then
            return 1;
        fi
        return 0;
    fi
    if b eq min then
        if a eq 1 then
            return 1;
        fi
        return 0;
    fi
    return mul_proof_nonmin(a,b);
}
// A bilinear product over an integer rectangle attains its extrema at corners.
pub fnc prove_i64_mul(int alo, int ahi, int blo, int bhi): int {
    if alo > ahi then
        return -1;
    fi
    if blo > bhi then
        return -1;
    fi
    if prove_i64_mul_pair(alo, blo) eq 0 then
        return 0;
    fi
    if prove_i64_mul_pair(alo, bhi) eq 0 then
        return 0;
    fi
    if prove_i64_mul_pair(ahi, blo) eq 0 then
        return 0;
    fi
    if prove_i64_mul_pair(ahi, bhi) eq 0 then
        return 0;
    fi
    return 1;
}
