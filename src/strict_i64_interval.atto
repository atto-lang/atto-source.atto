        fi
        term = term + term;
    fi
    if factor eq 0 then
        return 1;
    fi
    val half59: int = factor ashr 1;
    if factor - half59 * 2 eq 1 then
        if total < limit - term then
            return 0;
        fi
        total = total + term;
    fi
    factor = half59;
    if factor > 0 then
        if term < limit - term then
            return 0;
        fi
        term = term + term;
    fi
    if factor eq 0 then
        return 1;
    fi
    val half60: int = factor ashr 1;
    if factor - half60 * 2 eq 1 then
        if total < limit - term then
