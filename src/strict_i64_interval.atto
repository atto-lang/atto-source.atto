// Stage-0 Atto-authored, nonallocating interval admission kernel.
// Returns 1 when the stated operation is proved safe, 0 if not, -1 for
// malformed ranges. Not a parser, compiler CLI or self-hosting claim.
pub fnc prove_i64_add(int alo, int ahi, int blo, int bhi): int {
    if alo > ahi then
        return -1;
    fi
    if blo > bhi then
        return -1;
    fi
    val max: int = 9223372036854775807;
    val min: int = -9223372036854775807 - 1;
    // Subtractions are safe because the corresponding sign is checked.
    if bhi > 0 then
        if ahi > max - bhi then
            return 0;
        fi
    fi
    if blo < 0 then
        if alo < min - blo then
            return 0;
        fi
    fi
    return 1;
}
pub fnc prove_i64_div(int alo, int ahi, int blo, int bhi): int {
    if alo > ahi then
        return -1;
    fi
    if blo > bhi then
        return -1;
    fi
    if blo <= 0 then
        if bhi >= 0 then
            return 0;
        fi
    fi
    val min: int = -9223372036854775807 - 1;
    if alo eq min then
        if blo <= -1 then
            if bhi >= -1 then
                return 0;
            fi
        fi
    fi
    return 1;
}
// Receiver length is a supplied proof fact, not a pointer or array identity.
pub fnc prove_fixed_index(int lo, int hi, int length): int {
    if lo > hi then
        return -1;
    fi
    if length < 1 then
        return -1;
    fi
    if length > 16 then
        return -1;
    fi
    if lo < 0 then
        return 0;
    fi
    if hi >= length then
        return 0;
    fi
    return 1;
}


// Bounded Stage-0 slice proof: supplied extent is a proven fixed-array fact.
// No pointer, allocation, lifetime, or dynamic borrow authority is granted.
// -1 = invalid extent; 0 = out of bounds; 1 = safe half-open slice.
// An empty slice at the end, including an empty array, is permitted.
pub fnc prove_fixed_slice(int start, int count, int extent): int {
    if extent < 0 then return -1; fi
    if extent > 16 then return -1; fi
    if start < 0 then return 0; fi
    if count < 0 then return 0; fi
    if start > extent then return 0; fi
    if count > extent - start then return 0; fi
    return 1;
}

// Signed subtraction: compare endpoints without negating INT64_MIN.
pub fnc prove_i64_sub(int alo, int ahi, int blo, int bhi): int {
    if alo > ahi then
        return -1;
    fi
    if blo > bhi then
        return -1;
    fi
    val max: int = 9223372036854775807;
    val min: int = -9223372036854775807 - 1;
    if blo < 0 then
        if ahi > max + blo then
            return 0;
        fi
    fi
    if bhi > 0 then
        if alo < min + bhi then
            return 0;
        fi
    fi
    return 1;
}
// 63 fixed stages, partitioned into acyclic private helpers to respect the
// bootstrap compiler's local control-flow caps. Internal domain: nonpositive
// term/total, nonnegative factor, limit MIN or -MAX. No public entry to stages.
fnc mul_proof_stage31(int term, int factor, int total, int limit): int {
    val half0: int = factor ashr 1;
    val delta0: int = term * (factor - half0 * 2);
    if total < limit - delta0 then
        return 0;
    fi
    val sum0: int = total + delta0;
    if half0 eq 0 then
        return 1;
    fi
    return 0;
}

fnc mul_proof_stage30(int term, int factor, int total, int limit): int {
    val half0: int = factor ashr 1;
    val delta0: int = term * (factor - half0 * 2);
    if total < limit - delta0 then
        return 0;
    fi
    val sum0: int = total + delta0;
    if half0 eq 0 then
        return 1;
    fi
    if term < limit - term then
        return 0;
    fi
    val doubled0: int = term + term;
    val half1: int = half0 ashr 1;
    val delta1: int = doubled0 * (half0 - half1 * 2);
    if sum0 < limit - delta1 then
        return 0;
    fi
    val sum1: int = sum0 + delta1;
    if half1 eq 0 then
        return 1;
    fi
    if doubled0 < limit - doubled0 then
        return 0;
    fi
    val doubled1: int = doubled0 + doubled0;
    return mul_proof_stage31(doubled1, half1, sum1, limit);
}

