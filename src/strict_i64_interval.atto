    val doubled0: int = term + term;
    val half1: int = half0 ashr 1;
    val delta1: int = doubled0 * (half0 - half1 * 2);
    if sum0 < limit - delta1 then
        return 0;
    fi
    val sum1: int = sum0 + delta1;
    if half1 eq 0 then
        return 1;
    fi
    if doubled0 < limit - doubled0 then
        return 0;
    fi
    val doubled1: int = doubled0 + doubled0;
    return mul_proof_stage8(doubled1, half1, sum1, limit);
}

