// Atto compiler seed: bounded ASCII infix -> Wasm instruction bytes.
// Stage-0 portable spelling: `pub fnc` (LLVM scalar frontend does not
// currently admit the `define pub fnc` alias).
// NOT a complete compiler, native AOT proof, or self-hosted build.
// Input grammar: digit op digit; operators: + - *.
// Valid result range [-64, 63] for one-byte signed LEB128.
// Packed output byte order: i64.const (0x42), immediate, end (0x0b).
// Negative values represent compiler errors; never publish as code.

pub fnc ascii_digit_value(int ascii): int {
    if ascii < 48 then
        return -1;
    fi
    if ascii > 57 then
        return -1;
    fi
    return ascii - 48;
}

// Returns 1: add, 2: subtract, 3: multiply, 0: unsupported.
pub fnc ascii_binary_opcode(int ascii): int {
    if ascii eq 43 then
        return 1;
    fi
    if ascii eq 45 then
        return 2;
    fi
    if ascii eq 42 then
        return 3;
    fi
    return 0;
}

// This helper is public in the bootstrap seed. Validate operands even when
// called directly, not only when reached via compile_ascii_triplet.
// Without these guards, extreme caller-supplied i64 values could overflow.
pub fnc evaluate_digit_binary(int left, int opcode, int right): int {
    if left < 0 then
        return -1000;
    fi
    if left > 9 then
        return -1000;
    fi
    if right < 0 then
        return -1000;
    fi
    if right > 9 then
        return -1000;
    fi
    if opcode eq 1 then
        return left + right;
    fi
    if opcode eq 2 then
        return left - right;
    fi
    if opcode eq 3 then
        return left * right;
    fi
    return -1000;
}

// Converts a signed i64 integer [-64,63] to its one-byte SLEB128.
// -1001 signals an unsupported immediate size.
pub fnc signed_leb128_byte(int value): int {
    if value < -64 then
        return -1001;
    fi
    if value > 63 then
        return -1001;
    fi
    if value < 0 then
        return 128 + value;
    fi
    return value;
}

// 0x42=66 (i64.const), 0x0b=11 (end).
// Error codes: -1 bad lhs, -2 bad rhs, -3 bad op, -4 bad
// evaluator state, -5/-6 constant outside the one-byte SLEB range.
pub fnc compile_ascii_triplet(int lhs_ascii, int op_ascii, int rhs_ascii): int {
    val lhs: int = ascii_digit_value(lhs_ascii);
    if lhs < 0 then
        return -1;
    fi

    val rhs: int = ascii_digit_value(rhs_ascii);
    if rhs < 0 then
        return -2;
    fi

    val opcode: int = ascii_binary_opcode(op_ascii);
    if opcode eq 0 then
        return -3;
    fi

    val result: int = evaluate_digit_binary(lhs, opcode, rhs);
    if result eq -1000 then
        return -4;
    fi
    if result < -64 then
        return -5;
    fi
    if result > 63 then
        return -6;
    fi

    val immediate: int = signed_leb128_byte(result);
    if immediate < 0 then
        return -5;
    fi

    return 66 + immediate * 256 + 11 * 65536;
}

// Bounded Stage-0 quantity admission over already resolved unit IDs.
// 1=Second, 2=Millis, 3=Meter, 4=Second alias, 5=Millis alias.
// Not a declaration parser: these IDs are fixed bootstrap metadata.
// Only equal dimension AND equal scale may be erased by a ratio.
pub fnc quantity_seed_dimension(int unit_id): int {
    if unit_id eq 1 then return 1; fi
    if unit_id eq 2 then return 1; fi
    if unit_id eq 3 then return 2; fi
    if unit_id eq 4 then return 1; fi
    if unit_id eq 5 then return 1; fi
    return 0;
}

pub fnc quantity_seed_scale(int unit_id): int {
    if unit_id eq 1 then return 1; fi
    if unit_id eq 2 then return 1000; fi
    if unit_id eq 3 then return 1; fi
    if unit_id eq 4 then return 1; fi
    if unit_id eq 5 then return 1000; fi
    return 0;
}

// No unbounded loop or general signed division is needed for the
// single-digit seed. Each multiplication is bounded by 9*9.
pub fnc quantity_seed_digit_ratio(int left, int right): int {
    if left < 0 then return -4; fi
    if left > 9 then return -4; fi
    if right < 1 then return -4; fi
    if right > 9 then return -4; fi
    if left < right then return 0; fi
    if left < right * 2 then return 1; fi
    if left < right * 3 then return 2; fi
    if left < right * 4 then return 3; fi
    if left < right * 5 then return 4; fi
    if left < right * 6 then return 5; fi
    if left < right * 7 then return 6; fi
    if left < right * 8 then return 7; fi
    if left < right * 9 then return 8; fi
    return 9;
}

// Negative result = no emitted instruction fragment.
// -7 unknown unit, -8 dimension mismatch, -9 residual scale, -10 zero divisor.
pub fnc compile_quantity_digit_ratio(int lhs_ascii, int lhs_unit, int rhs_ascii, int rhs_unit): int {
    val lhs: int = ascii_digit_value(lhs_ascii);
    if lhs < 0 then return -1; fi
    val rhs: int = ascii_digit_value(rhs_ascii);
    if rhs < 0 then return -2; fi
    val left_dim: int = quantity_seed_dimension(lhs_unit);
    val right_dim: int = quantity_seed_dimension(rhs_unit);
    if left_dim eq 0 then return -7; fi
    if right_dim eq 0 then return -7; fi
    if left_dim neq right_dim then return -8; fi
    if quantity_seed_scale(lhs_unit) neq quantity_seed_scale(rhs_unit) then return -9; fi
    if rhs eq 0 then return -10; fi
    val result: int = quantity_seed_digit_ratio(lhs, rhs);
    if result < 0 then return -4; fi
    return 66 + signed_leb128_byte(result) * 256 + 11 * 65536;
}

// Stage-0 native smoke entry: "6*7" compiles to 731714.
// The subtraction makes exit status 42 on POSIX, if compiled and run.
// A passing exit code alone does NOT prove general source compilation.
pub fnc main(): int {
    return compile_ascii_triplet(54, 42, 55) - 731672;
}
